{
  "name": "b2b-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:deploy": "pnpm --filter @repo/database db:deploy",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:test-prepare": "pnpm --filter @repo/database db:test-prepare",
    "db:purge-test-residue": "pnpm --filter @repo/database db:purge-test-residue",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "hafiza": "node scripts/hafiza-esitle.mjs",
    "hafiza:geri": "node scripts/hafiza-esitle.mjs --geri",
    "shots": "node scripts/screenshots.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "puppeteer-core": "^23",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "@types/react": "18.2.79",
      "@types/react-dom": "18.2.25"
    }
  }
}
