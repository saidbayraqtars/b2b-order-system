# deps
node_modules/
.pnpm-store/

# builds
.next/
dist/
out/
.expo/
web-build/

# turbo
.turbo/

# Expo prebuild output. Regenerated from app.json by `expo prebuild`, so it is
# build output rather than source; committing it would mean maintaining the
# native projects by hand and losing what the config plugins do.
apps/mobile/android/
apps/mobile/ios/

# Release signing key. The APK is installed by hand rather than through Play
# Store, so this file *is* the app's identity: replacing it means every phone
# has to uninstall before it can take an update. Backed up outside the repo.
*.keystore
apps/mobile/android-signing/

# tsc incremental build artifacts
*.tsbuildinfo

# env
.env
.env.*
!.env.example
!.env.production.example

# prisma
packages/database/prisma/migrations/dev.db*

# OSS reference clones kept locally for study — never commit.
# Vendure is GPL-3.0 and Twenty is AGPL-3.0: vendoring their source here would
# put this repo under strong copyleft. Study the architecture, reimplement.
/refine/
/vendure/

# uploaded files (UPLOAD_DIR) — user content, never source
uploads/

# Tenant folders. Only the shipped `demo` belongs in the repo: a real customer's
# trade name, tax number and logo are that customer's data, not our source.
/tenants/*
!/tenants/README.md
!/tenants/demo/

# Güncelleme ajanının çalışma dizini (UPDATE_STATE_DIR): durum dosyası ve
# günlük. Kurulumun o anki hâli, kaynağın parçası değil.
/var/

# misc
.DS_Store
*.log
npm-debug.log*
coverage/
