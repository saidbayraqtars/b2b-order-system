// packages/database/prisma/schema.prisma
// B2B Order & Management System — MVP schema (currency fixed to TRY in business logic).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN // whole system
  COMPANY_ADMIN // company manager
  COMPANY_STAFF // purchaser (may require approval)
  SALES_REP // plasiyer / field sales
  COURIER // malı kapıya götüren, teslim kanıtı toplayan
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL // waiting company-admin approval
  PENDING_CREDIT // credit limit exceeded, waiting super-admin approval
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

/// How an *order* is agreed to be settled. Read by the credit check, by order
/// approval and by promotion conditions — see `paymentMethodMeta()` in
/// @repo/services for the one place that says which of these create a
/// receivable. Do not branch on individual members anywhere else.
enum PaymentMethod {
  OPEN_ACCOUNT // cari / açık hesap — borç doğurur, vadesi vardır
  CREDIT_CARD // sipariş anında ödenmiş sayılır
  BANK_TRANSFER // havale / EFT, peşin
  CASH // peşin nakit (teslimatta / plasiyere)
  CHEQUE // çek ile ödeme — borç doğurur, vadesi vardır
}

enum TransactionType {
  DEBIT // borç (order invoice)
  CREDIT // alacak (payment / refund)
}

/// How a collection (tahsilat) reached us. Still separate from PaymentMethod
/// even though the two now share member names: this one records what already
/// happened to money, the other records what an order *agreed* to and is read
/// by the credit check, approval and promotion rules. Merging them would make
/// every new collection channel a new branch in the order engine.
/// See Transaction.collectionMethod.
enum CollectionMethod {
  CASH // nakit
  BANK_TRANSFER // havale / EFT
  CHEQUE // çek
  PROMISSORY_NOTE // senet
  CREDIT_CARD // kredi kartı / sanal POS
  OTHER
}

/// Which application wrote a field record.
enum FieldEntrySource {
  MOBILE
  WEB
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// Whether a customer's hacim (turnover) tier is earned or granted.
enum VolumeDiscountMode {
  AUTO // recomputed from the customer's own turnover, every time it is priced
  MANUAL // pinned by an admin; turnover is not consulted at all
}

/// Which serial a document draws from. Waybill = irsaliye, invoice = fatura.
enum DocumentType {
  WAYBILL
  INVOICE
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

/// How a promotion joins its conditions.
enum ConditionMode {
  ALL // every condition must hold (AND)
  ANY // at least one must hold (OR)
}

// ─────────────────────────────────────────────
// AUTH & RBAC
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  role         Role    @default(COMPANY_STAFF)
  isActive     Boolean @default(true)

  /// Ne yapabileceğini belirleyen adlandırılmış izinler (@repo/types
  /// PermissionEnum). Rol yalnızca hangi bölüme girildiğini ve firma bağını
  /// söyler; yetkiyi bu küme söyler. Hesap açılırken rolün şablonuyla dolar,
  /// sonra tek tek açılıp kapatılır. Boş küme = hiçbir yönetim ekranı yok.
  /// Enum[] değil String[]: izin listesi ekran eklendikçe büyüyor ve her
  /// ekleme için migration yazmak listeyi kullanılamaz yapardı — bilinmeyen
  /// anahtarlar okunurken `sanitizePermissions` ile atılır.
  permissions String[] @default([])

  /// Bumped whenever the account's privileges or password change. Every issued
  /// session (web cookie JWT and mobile bearer token) carries the value it was
  /// minted with; a mismatch invalidates it on the next request. Without this,
  /// a demoted or deactivated user would keep their old role until the token
  /// expired — up to 30 days for mobile.
  tokenVersion Int @default(0)

  /// Login telemetry + brute-force brake. `lockedUntil` is set once
  /// `failedLoginCount` crosses the threshold and cleared on any success.
  lastLoginAt       DateTime?
  lastLoginIp       String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?

  // Company staff/admin belong to a company. Super admin & sales rep are null.
  companyId String?
  company   Company? @relation("CompanyMembers", fields: [companyId], references: [id])

  // Sales rep portfolio (reverse of Company.salesRep)
  managedCompanies Company[] @relation("SalesRepPortfolio")

  ordersCreated  Order[]       @relation("OrderCreatedBy")
  ordersApproved Order[]       @relation("OrderApprovedBy")
  shipments      Shipment[]    @relation("ShipmentShippedBy")
  invoicesIssued Invoice[]     @relation("InvoiceCreatedBy")
  checkIns       CheckIn[]
  transactions   Transaction[] @relation("TransactionRecordedBy")
  chequeEvents   ChequeEvent[] @relation("ChequeEventActor")
  exchangeRates  ExchangeRate[] @relation("ExchangeRateCreatedBy")
  jobRuns        JobRun[]       @relation("JobRunTriggeredBy")
  cashMovements  CashMovement[] @relation("CashMovementRecordedBy")
  stockMovements StockMovement[] @relation("StockMovementRecordedBy")
  pageLayouts    PageLayout[]    @relation("PageLayoutUpdatedBy")
  paymentIntents PaymentIntent[]      @relation("PaymentIntentCreatedBy")
  paymentEvents  PaymentIntentEvent[] @relation("PaymentIntentActor")
  statusChanges  OrderStatusHistory[] @relation("OrderStatusChangedBy")
  reports        ReportDefinition[]   @relation("ReportOwner")
  dashboards     ReportDashboard[]    @relation("DashboardOwner")
  auditLogs      AuditLog[]           @relation("AuditActor")
  passwordResets PasswordResetToken[]
  salesTargets   SalesTarget[]        @relation("SalesTargetRep")
  targetsAuthored SalesTarget[]       @relation("SalesTargetAuthor")
  pushDevices     PushDevice[]        @relation("PushDeviceOwner")
  visitRequests   VisitRequest[]      @relation("VisitRequestRep")
  visitRequestsAuthored VisitRequest[] @relation("VisitRequestAuthor")
  deliveries     Shipment[]           @relation("ShipmentCourier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

// ─────────────────────────────────────────────
// COMPANY (CARİ)
// ─────────────────────────────────────────────

model Company {
  id        String  @id @default(cuid())
  name      String
  taxNumber String? @unique
  taxOffice String?
  email     String?
  phone     String?

  /// This customer's cari code in the ERP (VegaWin A5 / VegaDB and the like).
  /// The join key the ERP bridge matches on — see erp-ingest.ts.
  externalCode String? @unique

  /// The balance the ERP last reported for this cari.
  ///
  /// Deliberately **not** written into `currentBalance`. That one is derived
  /// from this system's own Transaction ledger and every screen adds up against
  /// it; overwriting it with a number computed from a different set of books
  /// would leave the balance disagreeing with the ekstre printed beside it.
  /// This is shown next to ours so a human can see the two and investigate,
  /// which is the only honest thing to do with two sets of books.
  erpBalance   Decimal?  @db.Decimal(14, 2)
  erpSyncedAt  DateTime?

  // Cari / limit
  creditLimit    Decimal @default(0) @db.Decimal(14, 2)
  currentBalance Decimal @default(0) @db.Decimal(14, 2) // cache derived from Transaction ledger

  /// Buradaki `currency` kolonu **kaldırıldı** (Adım 52). Hiçbir hesap onu
  /// okumuyordu — defter TL — ama cari ekstre belgesi basıyordu: "USD"
  /// işaretlenmiş bir firmanın TL bakiyesi dolar diye çıkıyordu. Yabancı para
  /// `Price.currency`in özelliği; sipariş anında TL'ye çevrilir ve kullanılan
  /// kur `OrderItem.exchangeRate`e donar.

  /// Vade: days a debit may stay open before it counts as overdue in aging.
  /// This is the customer's *default* term — what an order gets when nobody
  /// picks one. `paymentTerms` below is the menu they may pick from instead.
  paymentTermDays Int @default(0)

  /// Which settlement methods this customer may choose at checkout.
  /// **Empty means no restriction** (every method is offered) — the same
  /// convention as Announcement.customerGroupIds. Restricting is opt-in, so
  /// existing customers keep working without a data migration.
  allowedPaymentMethods PaymentMethod[] @default([])

  /// The vade options offered to this customer at checkout. Empty = no choice:
  /// the order silently takes `paymentTermDays` above, which is how every
  /// order behaved before terms existed.
  paymentTerms PaymentTerm[] @relation("CompanyPaymentTerms")

  /// How this customer's hacim (turnover) discount is decided — see VolumeTier.
  /// AUTO earns it from actual turnover on every pricing request; MANUAL freezes
  /// it to the pin below, so a tier promised in a contract survives a slow
  /// quarter. Nothing is cached: the price a customer sees is always computed.
  volumeDiscountMode VolumeDiscountMode @default(AUTO)

  /// The pinned tier. Read **only** under MANUAL, where null means "no hacim
  /// discount for this customer" — that is how the feature is switched off for
  /// one cari without touching the ladder everyone else is on.
  volumeTierId String?
  volumeTier   VolumeTier? @relation(fields: [volumeTierId], references: [id])

  // If true, COMPANY_STAFF orders go to PENDING_APPROVAL before credit check.
  requiresOrderApproval Boolean @default(false)

  isActive Boolean @default(true)

  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  salesRepId String?
  salesRep   User?   @relation("SalesRepPortfolio", fields: [salesRepId], references: [id])

  members      User[]            @relation("CompanyMembers")
  addresses    Address[]
  orders       Order[]
  transactions Transaction[]
  cheques      Cheque[]
  discounts    CompanyDiscount[]
  checkIns     CheckIn[]
  carts        Cart[]
  promotionRedemptions PromotionRedemption[]
  invoices     Invoice[]
  paymentIntents PaymentIntent[]
  visitRequests  VisitRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerGroupId])
  @@index([salesRepId])
  @@index([volumeTierId])
}

model Address {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label      String // "Merkez", "Depo"
  line1      String
  line2      String?
  city       String
  district   String?
  postalCode String?
  isDefault  Boolean @default(false)

  /// Kapının koordinatı. Ziyaret haritası ve yol tarifi bunu okur.
  ///
  /// Neden adreste duruyor: `CheckIn` zaten konum taşıyor ama o *ziyaret
  /// olduktan sonraki* kanıt — plasiyer güne başlarken henüz hiçbir check-in
  /// yok, dolayısıyla haritada gösterilecek bir nokta da olmazdı. Boş
  /// bırakılabilir: koordinatı olmayan adres haritada listede kalır, pin
  /// düşmez.
  latitude  Float?
  longitude Float?

  shippedOrders Order[]

  @@index([companyId])
}

/// A named vade option — "Peşin", "30 gün", "60 gün".
///
/// Definitions are global; which customer may pick which is the m-n above.
/// An order does **not** point back here: it snapshots `paymentTermDays`, so
/// renaming or deleting "60 gün" next year cannot rewrite what a past order
/// was sold on. This row only decides what may be *chosen*.
model PaymentTerm {
  id String @id @default(cuid())
  /// Shown at checkout. Unique so the same vade cannot be defined twice under
  /// two names and drift apart.
  name String @unique
  /// Days added to the invoice date. 0 = peşin.
  days Int    @default(0)
  /// Kept out of the checkout menu without deleting it — orders sold on this
  /// term stay explainable.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  companies Company[] @relation("CompanyPaymentTerms")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// A rung on the turnover ladder: "buy at least `minRevenue` worth of goods in
/// the last `windowMonths` months and every line gets `discountPercent` off".
///
/// The ladder is global — it is the same offer to everyone, which is what makes
/// it a hacim iskontosu rather than a private deal (that is CompanyDiscount).
/// A customer gets the *best* rung it qualifies for, so rungs with different
/// windows can coexist: "500.000 in a year" and "80.000 in a month" are two
/// honest offers, and whichever pays the customer more is the one that applies.
model VolumeTier {
  id   String @id @default(cuid())
  /// Shown on the order and in the cart. Unique so two rungs cannot share a
  /// name and become impossible to tell apart on an old order.
  name String @unique

  /// Net goods turnover to reach — VAT and freight excluded, because neither is
  /// the seller's revenue and charging a customer's own VAT towards its tier
  /// would make the ladder depend on the product mix.
  minRevenue Decimal @db.Decimal(14, 2)

  /// Rolling window in months, counted back from the moment of pricing.
  windowMonths Int @default(12)

  /// Percent off, applied *after* the customer's own CompanyDiscount — iskonto
  /// üstüne iskonto, the way it is quoted in trade.
  discountPercent Decimal @db.Decimal(5, 2)

  /// Retired without deleting: orders sold on this rung stay explainable, and
  /// an inactive rung is simply never awarded.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

model CustomerGroup {
  id          String    @id @default(cuid())
  name        String    @unique // "Bayi", "Toptancı", "Zincir Market"
  description String?
  companies   Company[]
  prices      Price[]

  createdAt DateTime @default(now())
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String?

  // Tree (self relation)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products  Product[]
  discounts CompanyDiscount[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  images      String[] // URL list
  vatRate     Int      @default(20) // KDV % (TR: 1 / 10 / 20). Used for taxTotal calc.
  isActive    Boolean  @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants  ProductVariant[]
  discounts CompanyDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductVariant {
  id      String  @id @default(cuid())
  sku     String  @unique
  barcode String? @unique
  color   String?
  size    String?

  /// The stock code this variant has in the ERP — the join key the bridge
  /// matches stock and price rows on.
  externalCode String? @unique

  /// When the ERP last confirmed this row. Answers "is this stock figure from
  /// this morning or from three weeks ago", which a run log alone cannot: the
  /// run says what arrived, this says what it touched.
  erpSyncedAt DateTime?

  unitsPerCase Int  @default(1) // koli içi adet
  moqUnits     Int  @default(1) // minimum order quantity
  /// Toplam eldeki adet. Depo kırılımı `stocks` altında; bu kolon onların
  /// toplamı olarak tutulur çünkü katalog listesi tek satırda "var mı yok mu"
  /// sorusunu depo tablosuna gitmeden cevaplayabilmeli.
  stock        Int  @default(0)
  weightGram   Int?

  /// ERP'den gelen stok kartı alanları (VegaDB F0101TBLSTOKLAR karşılıkları).
  /// Hepsi opsiyonel: köprü bağlı değilken katalog bunlarsız da çalışır.
  /// Alış fiyatı (ALISFIYATI). Müşteriye **gösterilmez** — kâr raporu ve
  /// iskonto sınırı içindir; ekranlarda yalnızca `pricing.manage` yetkisi olan
  /// görür.
  costPrice Decimal? @db.Decimal(12, 2)
  /// Satış birimi: ADET, KG, KOLİ, MT…
  unit      String?
  /// Kritik stok eşiği (ASGARISTOK). Altına düşen satır uyarı ile listelenir.
  minStock  Int?
  /// Raf/lokasyon kodu — toplayıcı kâğıtta bunu arıyor.
  shelfCode String?
  /// ERP'de pasife çekilmiş kart. Silinmiyor: geçmiş siparişler bu satıra
  /// bakıyor. Pasif varyant katalogda görünmez, siparişe eklenemez.
  isActive  Boolean  @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  prices     Price[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  stocks     VariantStock[]
  movements  StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([barcode])
}

/// Depo. ERP'de birden çok ambar var ve "stok var" cevabı hangi ambarda
/// olduğuna göre değişiyor — merkez deponun malı şubeden satılamıyor.
model Warehouse {
  id       String  @id @default(cuid())
  /// ERP'deki ambar kodu; köprünün eşleştirme anahtarı.
  code     String  @unique
  name     String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  stocks    VariantStock[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bir varyantın bir depodaki miktarı.
///
/// `reserved`, onaylanmış ama sevk edilmemiş siparişlerin tuttuğu adet:
/// satılabilir miktar `onHand - reserved`. İkisini tek kolona indirmek "stok
/// var" deyip sevk edememe hatasını doğuruyordu.
model VariantStock {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  onHand   Int @default(0)
  reserved Int @default(0)

  erpSyncedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

// ─────────────────────────────────────────────
// STOK HAREKET DEFTERİ
// ─────────────────────────────────────────────
//
// `ProductVariant.stock` bir sayıdır: "şu an 12 adet". Nasıl 12 olduğunu
// söylemez. Sipariş düşürdü mü, ERP senkronu mu ezdi, biri elle mi düzeltti —
// hiçbiri kayıtlı değildi, dolayısıyla "stok neden düştü" sorusunun cevabı yoktu
// ve fark bulunduğunda kimse geriye dönüp bakamıyordu.
//
// Bu defter kasanın (CashMovement) stok karşılığı ve aynı iki kuralı taşır:
//  * Ekle-only. Yanlış kayıt UPDATE/DELETE ile değil, kendisine bağlı ters
//    kayıtla düzeltilir; kapanan bir günün sayısı sonradan sessizce değişemez.
//  * Bakiye ile hareket aynı veritabanı işleminde yazılır. `ProductVariant.stock`
//    artık bu defterin bakiyesidir; başka bir yerden yazıldığı an yalan olur.

enum StockDirection {
  IN // depoya giren
  OUT // depodan çıkan
}

/// Bir stok hareketinin sebebi. Ekrandaki "neden düştü" cevabı da, rapordaki
/// gruplama da bu kolonu okur.
enum StockMovementSource {
  ORDER // sipariş malı tuttu (satır oluşturulurken düşer)
  ORDER_CANCEL // iptal/ret malı geri verdi
  MANUAL // elle giriş/çıkış: fire, numune, hurda
  COUNT // sayım farkı — sayılan adet ile defterin farkı
  ERP // ERP senkronu farkı; senkron ezmez, farkı kadar hareket yazar
  TRANSFER // depolar arası aktarım (iki bacak)
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Hangi depo. Boş olabilir: tek depolu kurulumda depo kavramı hiç
  /// kullanılmıyor ve sipariş satırı bir depo seçmiyor. Depo adı verilen
  /// hareket ayrıca `VariantStock` kırılımını da oynatır.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  direction StockDirection
  /// Her zaman pozitif; işareti `direction` taşır.
  quantity  Int
  source    StockMovementSource

  /// Bu hareketten *sonraki* toplam eldeki adet. Türetilebilir ama satırda
  /// duruyor: defteri okuyan kişinin sorusu "o gün kaça düştü", ve o soruyu
  /// her satır için baştan toplam alarak cevaplamak defteri kullanılmaz yapar.
  balanceAfter Int

  description String?

  /// Malın gerçekten kımıldadığı an — satırın yazıldığı an değil. Dün yapılan
  /// sayım bu sabah girildiğinde düne aittir.
  occurredAt DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// Ters kayıt bağı, kasadakiyle aynı biçim: benzersiz, yani aynı hareketin
  /// iki kez iptal edilmesini veritabanı durdurur.
  reversalOfId String?        @unique
  reversalOf   StockMovement? @relation("StockMovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockMovement? @relation("StockMovementReversal")

  /// Aktarımın öbür bacağı. Depodan depoya taşımak iki satırdır — biri OUT,
  /// biri IN — ve yarısı tek başına anlamsızdır.
  counterpartId String?        @unique
  counterpart   StockMovement? @relation("StockTransfer", fields: [counterpartId], references: [id])
  counterpartOf StockMovement? @relation("StockTransfer")

  recordedById String?
  recordedBy   User?   @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([variantId, occurredAt])
  @@index([occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([source, occurredAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// DÖVİZ KURU
// ─────────────────────────────────────────────
//
// Ürün dolarla listelenebiliyor ama **defter TL**: cari, kasa, fatura, hepsi
// TL. Kur yalnızca liste fiyatını TL'ye çevirmek için okunuyor ve çevrildiği
// an siparişe yazılıyor. Böylece dün 34,20'den satılan mal, bugün kur 35 oldu
// diye geriye dönük pahalılaşmıyor.
//
// Kur tarihli: satır güncellenmiyor, yenisi ekleniyor. Bir siparişin hangi
// kurla fiyatlandığı sorusunun cevabı ancak o günün satırı durursa verilebilir.
model ExchangeRate {
  id       String @id @default(cuid())
  /// ISO 4217, üç harf. TRY burada tutulmaz — taban para birimi, kuru 1.
  currency String

  /// 1 birim yabancı para kaç TL. Altı ondalık: JPY gibi küçük birimlerde iki
  /// basamak anlamlı fark yaratıyor.
  rate Decimal @db.Decimal(18, 6)

  /// Bu kurun geçerli olmaya başladığı an. Fiyatlama "şu ana kadarki en son"
  /// satırı okur.
  validFrom DateTime @default(now())

  /// Nereden geldiği — elle mi girildi, bir servisten mi çekildi.
  source String @default("MANUAL")

  createdById String?
  createdBy   User?   @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([currency, validFrom])
  @@index([currency, validFrom])
}

// Price: variant × customer group × quantity tier.
// customerGroupId null = default list price.
model Price {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  minQuantity Int     @default(1) // tiered pricing threshold
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("TRY")

  @@unique([variantId, customerGroupId, minQuantity])
  @@index([variantId])
}

// Company-specific discount, by category OR product.
// INVARIANT (enforced in service layer): at least one of categoryId / productId must be set.
// Applied on top of the resolved group price.
model CompanyDiscount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  discountType DiscountType @default(PERCENTAGE)
  value        Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([categoryId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// DOCUMENTS (irsaliye / fatura)
// ─────────────────────────────────────────────

/// A numbering serial. Numbers are handed out by incrementing `lastNumber` inside
/// the caller's transaction, so two concurrent shipments can never take the same
/// one — the row lock serialises them.
///
/// `externalOnly` exists because this system is meant to run next to an ERP
/// (VegaWin A5 / VegaDB and the like): when the ERP owns the serial, this app
/// must not invent numbers, and refuses to allocate until one is supplied.
model DocumentSeries {
  id   String       @id @default(cuid())
  type DocumentType

  /// Printed in front of the number, e.g. "IRS" → IRS000042.
  prefix String
  /// Zero-padded width of the numeric part.
  padding Int @default(6)
  /// Last number handed out. Never decreases; a cancelled document burns its number.
  lastNumber Int @default(0)

  /// The serial new documents of this type are drawn from. One per type.
  isDefault Boolean @default(false)
  /// Numbers come from the ERP — the app will not allocate, it demands one.
  externalOnly Boolean @default(false)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, prefix])
  @@index([type, isDefault])
}

// ─────────────────────────────────────────────
// ETİKET & FİŞ ŞABLONLARI
// ─────────────────────────────────────────────

/// Şablonun hangi kâğıda, hangi iş için basıldığı.
///
/// Tür, şablonun *neyi doldurabileceğini* belirler: kargo etiketi siparişin
/// adres bilgisini, teslim fişi imza satırını tanır. Serbest bir "şablon"
/// kavramı olsaydı hangi alanın hangi ekranda dolduğunu kimse bilemezdi.
enum LabelTemplateKind {
  CARGO_LABEL // kargo/koli etiketi
  ORDER_RECEIPT // sipariş fişi (80 mm)
  DELIVERY_RECEIPT // teslim fişi (80 mm)
}

/// Kullanıcı tarafından düzenlenebilen etiket/fiş tasarımı.
///
/// Tasarım `blocks` içinde satır listesi olarak duruyor (bkz.
/// @repo/types labelTemplateSchema): her satır bir metin, çizgi, barkod ya da
/// kalem tablosu. Serbest sürükle-bırak koordinat düzeni değil — 80 mm'lik
/// termal yazıcı zaten satır satır basıyor ve mutlak konumlandırma her
/// yazıcıda başka türlü çıkıyor.
///
/// Alanlar `{{...}}` işaretleriyle yazılır ve basım anında doldurulur;
/// bilinmeyen bir işaret boş basılır, hata vermez — yarım basılmış bir fiş,
/// hiç basılmamış bir fişten daha kötüdür.
model LabelTemplate {
  id   String            @id @default(cuid())
  kind LabelTemplateKind
  name String

  /// Kâğıt genişliği (mm). 80 mm termal, 100 mm etiket gibi.
  widthMm  Int
  /// Sabit yükseklik (mm). Null = rulo: içerik kadar uzar.
  heightMm Int?

  /// Satır listesi. Şeması @repo/types tarafında doğrulanır.
  blocks Json

  /// Türün varsayılanı. Ekranlar şablon seçmeden basınca bu kullanılır.
  /// Aynı tür içinde tek bir varsayılan olmasını servis katmanı sağlar.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

/// One despatch (irsaliye). An order can have several: partial shipment is the
/// normal case, not the exception.
model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// İrsaliye numarası, from a DocumentSeries. Unique for the life of the system.
  documentNumber String @unique
  /// The ERP's own number when it owns the serial.
  externalNumber String?

  shippedAt      DateTime @default(now())
  carrier        String?
  trackingNumber String?
  note           String?

  shippedById String
  shippedBy   User   @relation("ShipmentShippedBy", fields: [shippedById], references: [id])

  /// Set once this despatch has been invoiced.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  /// Malı kapıya götüren kurye. `shippedBy` depodan çıkaran kişidir; ikisi
  /// aynı kişi olmak zorunda değil ve teslim kanıtı kuryeye aittir.
  courierId String?
  courier   User?   @relation("ShipmentCourier", fields: [courierId], references: [id])

  /// Teslim anı. Dolduğu an sevkiyat kapanmış sayılır.
  deliveredAt DateTime?
  /// Teslim alanın adı — kaşe/imza kimin attığı, hesap değil, kâğıttaki isim.
  receivedByName String?
  /// İmzalı belgenin fotoğrafı (yüklenen medyanın yolu). Kanıt bu; teslim
  /// kaydının kendisi tek başına imza yerine geçmez.
  proofPhotoUrl String?
  deliveryNote  String?

  items ShipmentItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([invoiceId])
  /// Kuryenin "bugün bende ne var" listesi.
  @@index([courierId, deliveredAt])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Units despatched in this shipment — never more than the line has left.
  quantity Int

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

/// A fatura. Issued for whatever of the order has not been invoiced yet, either
/// from selected shipments or from the order's remaining quantities.
model Invoice {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  documentNumber String  @unique
  externalNumber String?

  status InvoiceStatus @default(ISSUED)

  issuedAt DateTime @default(now())
  /// Vade. Defaults to issue date + the order's own term, falling back to the
  /// company's. This is the date aging buckets by — not the order date.
  dueDate DateTime

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal @default(0) @db.Decimal(14, 2)
  promotionTotal Decimal @default(0) @db.Decimal(14, 2)
  /// Charged once per order, on its first invoice.
  shippingFee Decimal @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal @default(0) @db.Decimal(14, 2)
  grandTotal  Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("TRY")

  note String?

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items     InvoiceItem[]
  shipments Shipment[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([companyId, issuedAt])
  @@index([status, dueDate])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Kept so an invoice can be traced back to the line it billed. Null only if
  /// the order line was removed, which nothing in the app does today.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  /// This invoice's share of the line's campaign discount, allocated by quantity.
  promotionDiscount Decimal @default(0) @db.Decimal(14, 2)
  vatRate           Int     @default(20)
  lineTotal         Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([orderItemId])
}

// ─────────────────────────────────────────────
// PROMOTION (rule engine)
// ─────────────────────────────────────────────

/// A campaign expressed as data: a list of conditions that must all hold and a
/// list of actions that produce the discount. Both are JSON arrays of
/// `{ type, params }`, where `type` must name an entry in the promotion rule
/// registry in @repo/services — the registry is the security boundary, so a row
/// edited directly in the database still cannot invent a rule or reach a field
/// the registry does not expose.
///
/// Promotions apply on top of the resolved group price and the company discount,
/// never instead of them.
model Promotion {
  id          String  @id @default(cuid())
  name        String
  description String?

  /// null = automatic (applies whenever its conditions hold).
  /// Otherwise the coupon code the buyer has to type; stored upper-case.
  code String? @unique

  enabled  Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  /// Lower runs first. Each promotion sees the line totals left by the ones
  /// before it, so order decides how stacked campaigns compound.
  priority Int @default(0)

  /// Stop evaluating the remaining promotions once this one has applied —
  /// how an "exclusive" campaign is expressed.
  stopFurther Boolean @default(false)

  /// How the conditions are joined. ALL is AND (the default and the safe one);
  /// ANY is OR, for "either of these customers" style campaigns that would
  /// otherwise need one promotion per alternative.
  conditionMode ConditionMode @default(ALL)

  /// Redemption caps; null = unlimited. Counted from PromotionRedemption, so a
  /// cancelled order gives its redemption back.
  usageLimit      Int?
  perCompanyLimit Int?

  conditions Json @default("[]")
  actions    Json @default("[]")

  redemptions PromotionRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, priority])
}

/// One promotion applied to one order. Doubles as the usage counter: the caps on
/// Promotion are checked against these rows, and cancelling an order deletes its
/// rows so the quota is released.
model PromotionRedemption {
  id String @id @default(cuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Discount this promotion granted on that order, excl. VAT. Always positive.
  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([promotionId, orderId])
  @@index([companyId])
  @@index([orderId])
}

// ─────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // human-readable serial
  status        OrderStatus   @default(DRAFT)
  paymentMethod PaymentMethod @default(OPEN_ACCOUNT)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Placed by (staff OR sales rep)
  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Approved by (company admin or super admin)
  approvedById String?
  approvedBy   User?   @relation("OrderApprovedBy", fields: [approvedById], references: [id])

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])

  // Totals — computed from item snapshots (price frozen at order time).
  // grandTotal = subtotal − discountTotal − promotionTotal + shippingFee + taxTotal,
  // and the tax is charged on the net *after* promotions (goods VAT + shipping VAT).
  // shippingFee is already net of any freight campaign, so shippingDiscount
  // does not appear in that sum — it would be subtracted twice.
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  /// Campaign discount on the *goods*, excl. VAT. Always equal to the sum of
  /// OrderItem.promotionDiscount — invoicing splits this figure across the
  /// lines, so a freight discount must not be hiding in it.
  promotionTotal Decimal @default(0) @db.Decimal(14, 2)
  /// Freight actually charged, excl. VAT — already net of any campaign on it.
  /// Only the seller side may set it.
  shippingFee    Decimal @default(0) @db.Decimal(14, 2)
  /// What a campaign took off the freight. Kept for reporting; it is already
  /// gone from shippingFee, so it is NOT part of the grand-total arithmetic.
  shippingDiscount Decimal @default(0) @db.Decimal(14, 2)
  shippingVatRate Int    @default(20)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("TRY")

  /// Vade agreed for this order, as a snapshot in days — either the option the
  /// buyer picked from Company.paymentTerms or a seller's free-form override.
  /// Null falls back to Company.paymentTermDays. The invoice takes its due date
  /// from here, and aging uses it for debts not yet invoiced.
  paymentTermDays Int?

  /// The hacim tier this order was priced under, snapshotted by name and rate.
  /// No FK on purpose, exactly as with the vade: retiring "Altın %5" next year
  /// must not rewrite what a customer was charged today. Zero = none applied.
  volumeTierName        String?
  volumeDiscountPercent Decimal @default(0) @db.Decimal(5, 2)

  /// The coupon the buyer typed, kept for the record even after the campaign ends.
  couponCode String?

  note String?

  // Fulfillment (set as the order moves through PROCESSING → SHIPPED → DELIVERED)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  items          OrderItem[]
  transactions   Transaction[]
  cashMovements  CashMovement[]
  stockMovements StockMovement[]
  paymentIntents PaymentIntent[]
  statusHistory  OrderStatusHistory[]
  promotions    PromotionRedemption[]
  shipments     Shipment[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

// Audit trail of every status change, including the initial one at creation.
// Kept append-only: the current status lives on Order, this is the "how it got there".
model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// null for the row written when the order is first created.
  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedById String
  changedBy   User   @relation("OrderStatusChangedBy", fields: [changedById], references: [id])

  note String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // Order-time snapshot (stable even if product/price changes later)
  productName String
  sku         String
  quantity    Int // total units
  caseCount   Int? // number of cases (if case-based)
  unitPrice   Decimal @db.Decimal(12, 2)
  /// **Total** discount per unit off `unitPrice`: the company's own discount
  /// plus whatever the hacim tier added. Invoicing and reporting multiply this
  /// by the quantity, so it must stay the whole figure.
  discount    Decimal @default(0) @db.Decimal(12, 2)
  /// The part of `discount` that came from the hacim tier — carried separately
  /// so a report can answer "what did the turnover ladder cost us" without
  /// re-deriving it from a percentage that may since have changed.
  volumeDiscount Decimal @default(0) @db.Decimal(12, 2)
  /// Promotion discount for the whole line (not per unit) — promotions are
  /// allocated to lines, so this is what the campaign took off this line.
  promotionDiscount Decimal @default(0) @db.Decimal(14, 2)
  vatRate     Int     @default(20) // snapshot of Product.vatRate
  lineTotal   Decimal @db.Decimal(14, 2) // net of both discounts, excl. VAT

  /// Fiyatın listelendiği para birimi ve o gün kullanılan kur.
  ///
  /// Defter TL: `unitPrice` ve `lineTotal` **her zaman** TL'dir. Bu iki kolon
  /// yalnızca "100 USD × 34,2150" satırını basabilmek için var. Kur siparişte
  /// donuyor — yarın kur değiştiğinde dünkü siparişin tutarı değişmemeli.
  listCurrency  String  @default("TRY")
  exchangeRate  Decimal @default(1) @db.Decimal(18, 6)
  /// Orijinal para birimindeki birim fiyat. Kurdan geri hesaplanabilir ama
  /// yuvarlama yüzünden kuruş oynar; belgede basılan sayı burada duruyor.
  listUnitPrice Decimal? @db.Decimal(12, 2)

  /// A line a campaign added for free. It carries its list value and an equal
  /// promotion discount, so it nets to zero without pretending the goods were
  /// worthless — which is what an invoice ("bedelsiz") has to show.
  isGift Boolean @default(false)

  /// Running totals for partial fulfilment. Both are <= quantity, and invoiced
  /// never exceeds shipped when the invoice was raised from a despatch.
  quantityShipped   Int @default(0)
  quantityInvoiced  Int @default(0)

  shipmentItems ShipmentItem[]
  invoiceItems  InvoiceItem[]

  @@index([orderId])
  @@index([variantId])
}

// ─────────────────────────────────────────────
// CARİ LEDGER
// ─────────────────────────────────────────────

model Transaction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2) // always positive; sign implied by type
  paymentMethod PaymentMethod? // the order's agreed method, copied onto its debt row
  description   String?

  /// How the money physically arrived, for collections only.
  ///
  /// Deliberately NOT PaymentMethod: that enum answers "how will this order be
  /// paid" (açık hesap / kredi kartı) and is read by order approval and by
  /// promotion conditions. Cash and cheque are meaningless there, and widening
  /// it would push them into both. A collection is a different question, so it
  /// gets its own answer.
  collectionMethod CollectionMethod?

  /// İstemcinin verdiği tekrar anahtarı.
  ///
  /// Aynı tahsilatı iki kez yazmanın önündeki tek gerçek engel. Ekrandaki onay
  /// adımı ve kilitlenen düğme, ağ koptuğunda yeniden gönderen bir istemciyi
  /// durdurmuyor. Tekil olduğu için ikinci istek veritabanında kalıyor —
  /// uygulama kodundaki "önce bak sonra yaz" yarışa açıktı.
  idempotencyKey String? @unique

  /// Set on the correcting entry that reverses an earlier collection. The
  /// ledger is append-only: a mistaken tahsilat is undone by a DEBIT of the
  /// same amount pointing here, never by deleting the CREDIT row. Unique, so
  /// the database — not a check-then-write in application code — is what
  /// prevents the same collection being reversed twice.
  reversalOfId String?      @unique
  reversalOf   Transaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversedBy   Transaction? @relation("TransactionReversal")

  /// When this debt falls due. Written at order time from the company's term and
  /// re-stamped by the invoice once one is issued, because the invoice is what
  /// actually starts the clock. Aging reads this; rows without it fall back to
  /// createdAt + Company.paymentTermDays (pre-invoicing history).
  dueDate DateTime?

  // Linked order if this debt originates from an order
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Sales rep / admin who recorded the collection
  recordedById String?
  recordedBy   User?   @relation("TransactionRecordedBy", fields: [recordedById], references: [id])

  /// The till entry this ledger row was paired with, when the money physically
  /// arrived. A cheque collection has no counterpart here — see CashMovement.
  cashMovement CashMovement?

  /// Bu tahsilatın doğurduğu kâğıt. Çek/senet tahsilatı kasaya girmiyor ama
  /// portföyde bir satır açıyor; ikisi tek işlemde yazılır.
  cheque Cheque?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([orderId])
  // Statements and aging always read one company's ledger in date order.
  @@index([companyId, createdAt])
  @@index([recordedById, createdAt])
  @@index([companyId, dueDate])
}

// ─────────────────────────────────────────────
// KASA & BANKA DEFTERİ
// ─────────────────────────────────────────────
//
// Transaction is the *customer's* ledger: what they owe us. It answers "bu
// müşteri ne kadar borçlu". It cannot answer "bugün kasaya ne girdi", because a
// cash or card sale never touches it — there is no debt to record. That money
// used to leave no trace anywhere. These three tables are the second ledger:
// what we hold, and where.

/// Where the money physically sits. Same ledger, different place.
enum CashAccountKind {
  CASH // kasa — elde duran nakit
  BANK // banka hesabı
  POS // sanal/fiziksel POS — para bankaya geçene kadar burada bekler
}

enum CashDirection {
  IN // giriş
  OUT // çıkış
}

/// Why a till entry was written. Reports group by it, and the reversal rules
/// differ: an ORDER entry is undone by cancelling the order, a MANUAL one by
/// hand.
enum CashMovementSource {
  ORDER // peşin siparişin bedeli
  COLLECTION // cariden tahsilat
  MANUAL // elle girilen gelir/gider
  TRANSFER // hesaplar arası aktarım
  CHEQUE // tahsil edilen çek/senet — para kâğıdın vadesinde giriyor
}

model CashAccount {
  id   String          @id @default(cuid())
  name String          @unique
  kind CashAccountKind @default(CASH)

  /// Bu defterin para birimi. Çoklu para birimi gelene kadar tek değer taşır;
  /// kolon şimdiden var ki hesap açarken sorulan soru sonradan eklenmesin.
  currency String @default("TRY")

  bankName String?
  iban     String?

  /// Devir bakiyesi — sistem kurulmadan önce kasada duran para. Hareket
  /// değildir, bu yüzden defterde satırı yoktur; bakiye bunun üzerine toplanır.
  openingBalance Decimal @default(0) @db.Decimal(14, 2)

  /// Hareketlerden türetilebilir, ama her ekranda toplam almamak için burada
  /// tutulur. Company.currentBalance ile aynı anlaşma: yazan her yer ikisini
  /// aynı veritabanı işleminde günceller, yoksa ayrışırlar.
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  /// Yöntemi eşlenmemiş her para buraya düşer. Tam bir tane olduğunu servis
  /// katmanı garanti eder (cash.ts): kurulumda bir kasa açılır, son varsayılan
  /// ne silinebilir ne pasife alınabilir.
  isDefault Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  movements      CashMovement[]
  methodBindings PaymentMethodAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model CashMovement {
  id        String      @id @default(cuid())
  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id])

  direction   CashDirection
  amount      Decimal            @db.Decimal(14, 2) // always positive; the sign is `direction`
  source      CashMovementSource
  description String?

  /// When the money actually moved, which is not when the row was typed. A
  /// collection taken yesterday and entered this morning belongs to yesterday's
  /// gün sonu, so every report reads this and not createdAt.
  occurredAt DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// The cari row this entry was written beside. A collection writes both in
  /// one transaction; a peşin order has no cari row at all, so this stays null.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  /// Reversal link, the same shape as Transaction's: a wrong entry is undone by
  /// its opposite, never by deleting the row. Unique, so the database is what
  /// stops the same entry being reversed twice.
  reversalOfId String?       @unique
  reversalOf   CashMovement? @relation("CashMovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   CashMovement? @relation("CashMovementReversal")

  /// The other leg of a transfer. Kasadan bankaya yatırmak iki satırdır — one
  /// OUT, one IN — and half of it alone means nothing.
  counterpartId String?       @unique
  counterpart   CashMovement? @relation("CashTransfer", fields: [counterpartId], references: [id])
  counterpartOf CashMovement? @relation("CashTransfer")

  recordedById String?
  recordedBy   User?   @relation("CashMovementRecordedBy", fields: [recordedById], references: [id])

  /// The card payment this entry settled, when it came from one.
  paymentIntent PaymentIntent?

  createdAt DateTime @default(now())

  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@index([orderId])
  @@index([source, occurredAt])
}

// ─────────────────────────────────────────────
// ZAMANLANMIŞ İŞLER
// ─────────────────────────────────────────────
//
// Süresi geçmiş şifre biletleri, denetim kaydı saklama süresi, yetim görseller:
// hepsi periyodik olması gereken ama kimsenin hatırlamasına bırakılmış işlerdi.
//
// Zamanlayıcı uygulamanın içinde çalışıyor (ayrı bir cron kapsayıcısı, kurulum
// başına ikinci bir dağıtım birimi demekti). Bunun bedeli, iki kopya
// çalıştığında ikisinin de aynı işi koşturması; `nextRunAt`'i ileri atarak
// **sahiplenme** bu yüzden var — işi alan kopya satırı tek bir UPDATE ile
// kilitliyor, alamayan hiç başlamıyor.

model JobSchedule {
  /// Kayıt defterindeki iş adı (`job-registry.ts`).
  name String @id

  intervalMinutes Int
  nextRunAt       DateTime
  lastRunAt       DateTime?
  lastStatus      String?
  lastSummary     String?
  isEnabled       Boolean   @default(true)

  updatedAt DateTime @updatedAt

  @@index([isEnabled, nextRunAt])
}

/// Her çalıştırmanın kaydı. Sonuç kolonu `JobSchedule`'da da duruyor ama orası
/// yalnızca sonuncuyu biliyor; "bu iş dün de patladı mı" sorusu ancak geçmiş
/// tutulursa yanıtlanıyor.
model JobRun {
  id   String @id @default(cuid())
  name String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | ERROR
  status  String  @default("RUNNING")
  summary String?
  error   String?
  /// Elle tetiklendiyse tetikleyen.
  triggeredById String?
  triggeredBy   User?   @relation("JobRunTriggeredBy", fields: [triggeredById], references: [id])

  @@index([name, startedAt])
  @@index([startedAt])
}

// ─────────────────────────────────────────────
// ÇEK / SENET PORTFÖYÜ
// ─────────────────────────────────────────────
//
// Çekle yapılan tahsilat cariyi kapatır ama kasaya girmez: kâğıt henüz para
// değil. Bu iki tablo o kâğıdın kendisini tutuyor — vadesi, kimin, nerede ve
// sonunda ne olduğu. Para kasaya **tahsil edildiğinde** giriyor; karşılıksız
// çıktığında kapanan borç geri açılıyor.

enum ChequeKind {
  CHEQUE
  PROMISSORY_NOTE
}

enum ChequeStatus {
  PORTFOLIO // elimizde, vadesini bekliyor
  DEPOSITED // tahsile verildi
  CLEARED // tahsil edildi — kasaya bu adımda girer
  BOUNCED // karşılıksız — borç geri açılır
  ENDORSED // ciro edildi
  RETURNED // müşteriye iade — borç geri açılır
  CANCELLED // altındaki tahsilat iptal edildi
}

model Cheque {
  id   String       @id @default(cuid())
  kind ChequeKind   @default(CHEQUE)
  status ChequeStatus @default(PORTFOLIO)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Kâğıdı doğuran tahsilat. Zorunlu ve tekil: portföyde cariyi kapatmamış
  /// bir çek satırı olamaz, bir tahsilat da iki kâğıt doğuramaz.
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  amount Decimal @db.Decimal(14, 2)

  /// Künye. Hepsi boş bırakılabilir: sahada yalnızca tutar giriliyor, gerisi
  /// ofiste tamamlanıyor. Vadesi boş olan kâğıt ekranda eksik işaretlenir.
  serialNumber String?
  bankName     String?
  branchName   String?
  drawerName   String?
  dueDate      DateTime?
  notes        String?

  /// Tahsil edildiğinde parayı alan hesap ve yazılan kasa hareketi.
  cashAccountId String?
  cashMovementId String? @unique

  /// Ciro edilen taraf. Serbest metin: çoğu zaman bizim sistemimizde kayıtlı
  /// olmayan bir tedarikçi.
  endorsedTo String?

  /// Karşılıksız/iade durumunda borcu geri açan ters kayıt.
  reopenTransactionId String? @unique

  settledAt DateTime?

  events ChequeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([companyId, status])
  @@index([dueDate])
}

/// Kâğıdın geçmişi. Durum kolonu son hâli söyler, bu tablo yolu: "ne zaman
/// tahsile verildi, kim karşılıksız işaretledi" soruları tek kolondan
/// yanıtlanamıyor ve bu bilgi ihtilafta gereken şey.
model ChequeEvent {
  id       String @id @default(cuid())
  chequeId String
  cheque   Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  fromStatus ChequeStatus?
  toStatus   ChequeStatus
  note       String?

  actorId String?
  actor   User?   @relation("ChequeEventActor", fields: [actorId], references: [id])

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([chequeId, occurredAt])
}

// ─────────────────────────────────────────────
// ÖDEME NİYETİ (sanal POS / ödeme sağlayıcı)
// ─────────────────────────────────────────────
//
// A card order used to walk straight into the till: the money was booked the
// moment the order was confirmed, though nobody had charged anything. That is
// a record of money we do not have.
//
// A PaymentIntent is the missing step. The order is confirmed, the intent is
// opened, and the till only hears about it when the charge actually succeeds —
// whether that is a provider capturing the card or an operator confirming they
// swiped it on the physical POS on the counter.

/// Where an intent is in its life. Deliberately provider-agnostic: iyzico,
/// PayTR and a bank VPOS all use different words for the same five states, and
/// the order pipeline must not learn any of their vocabularies.
enum PaymentIntentStatus {
  /// Opened, nothing charged. A physical-POS installation lives here until a
  /// human confirms; a 3DS flow lives here while the customer is at the bank.
  PENDING
  /// Held on the card but not taken. Providers that separate the two use it.
  AUTHORIZED
  /// Money taken. This — and only this — is what writes the till entry.
  CAPTURED
  /// Refused by the provider or by the bank. `failureReason` says why.
  FAILED
  /// Given up on: the order was cancelled, or an operator abandoned it.
  CANCELLED
  /// Taken and given back. The till entry is reversed, never deleted.
  REFUNDED
}

model PaymentIntent {
  id String @id @default(cuid())

  /// Registry key of the provider that owns this intent ("manual", "iyzico"…).
  /// A plain string, not an enum: which providers exist is a property of the
  /// installation, and a database enum would need a migration per customer.
  provider String

  status PaymentIntentStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("TRY")

  /// Taksit sayısı. 1 means peşin. The provider decides what it will accept;
  /// this records what was asked for.
  installmentCount Int @default(1)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// The provider's own identifier, for reconciliation against its panel.
  providerRef String?

  /// Where to send the customer for 3-D Secure. Transient — cleared once the
  /// flow ends, because a stale bank URL is worse than none.
  redirectUrl String?

  failureReason String?

  /// The till entry written when this was captured. Null until then, which is
  /// exactly the bug this model exists to fix.
  cashMovementId String?       @unique
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id])

  createdById String?
  createdBy   User?   @relation("PaymentIntentCreatedBy", fields: [createdById], references: [id])

  events PaymentIntentEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  capturedAt  DateTime?
  cancelledAt DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([companyId, createdAt])
  @@index([provider, providerRef])
}

/// Append-only history of one intent. A payment that went wrong is the single
/// most argued-about record in the system — the customer says they paid, the
/// bank says nothing arrived — so every transition it made is kept, not just
/// the state it ended in.
model PaymentIntentEvent {
  id       String        @id @default(cuid())
  intentId String
  intent   PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  status PaymentIntentStatus
  /// Short human line: what happened, in Turkish, for the operator reading it.
  note String?

  /// The provider's response, with card data stripped before it gets here.
  /// Never a PAN, never a CVV — see payment-provider-registry.ts, which is the
  /// only place a provider payload is allowed to be shaped.
  payload Json?

  actorId String?
  actor   User?   @relation("PaymentIntentActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([intentId, createdAt])
}

// ─────────────────────────────────────────────
// ERP KÖPRÜSÜ (ajan)
// ─────────────────────────────────────────────
//
// The customer's ERP — VegaWin A5 for the first one — is where their accountant
// works and where e-fatura already happens. This system does not reach into it
// over the network: a small **agent** runs on the customer's own machine, reads
// the ERP, and posts normalised data here over HTTPS.
//
// The agent, not this system, is what knows the ERP's schema. That is a
// security decision, not a tidiness one: the alternative — an agent that runs
// whatever SQL it is handed — would mean anyone who compromised this server
// could run arbitrary SQL inside the customer's accounting database. The agent
// exposes a fixed set of named read operations and nothing else.

/// What one sync run carried. Named rather than free-form so the ingest side
/// can refuse a payload that does not match what it claims to be.
enum ErpSyncKind {
  /// Cari kartları — codes, names, tax numbers.
  CUSTOMERS
  /// Stok miktarları.
  STOCK
  /// Fiyat listesi.
  PRICES
  /// Cari bakiyeleri — informational, never overwrites our own ledger.
  BALANCES
}

enum ErpSyncStatus {
  RUNNING
  SUCCEEDED
  /// Applied what it could; `ErpSyncIssue` rows say what it could not.
  PARTIAL
  FAILED
}

/// One agent process, and the credential it authenticates with.
model ErpAgent {
  id   String @id @default(cuid())
  name String @unique

  /// Which ERP it speaks to. Free text — the agent's own business; this side
  /// only records it so an operator reading the screen knows what they are
  /// looking at.
  erp String @default("vega")

  /// SHA-256 of the bearer token. The token itself is shown **once**, when it
  /// is issued, and never stored — same treatment PasswordResetToken gets. A
  /// leaked database must not hand over the ability to write stock and prices.
  tokenHash String @unique

  /// Last four characters of the token, so an operator can tell two agents
  /// apart when deciding which to revoke. Not enough to authenticate with.
  tokenHint String?

  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  /// Where it called from, for the same reason AuditLog keeps one.
  lastSeenIp String?

  runs ErpSyncRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErpSyncRun {
  id      String    @id @default(cuid())
  agentId String?
  agent   ErpAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  kind   ErpSyncKind
  status ErpSyncStatus @default(RUNNING)

  /// How many rows arrived, and what became of them. `skipped` is the number
  /// the bridge could not match to anything here — the figure that says whether
  /// the mapping is finished.
  received Int @default(0)
  applied  Int @default(0)
  skipped  Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  issues ErpSyncIssue[]

  @@index([kind, startedAt])
  @@index([agentId, startedAt])
}

/// A row the bridge could not apply, kept so somebody can fix the mapping.
///
/// Without this a sync that silently dropped 4.000 of 80.000 cari would look
/// exactly like one that worked. The unmatched code is the whole value here:
/// it is what an operator pastes into the ERP to find out what it belongs to.
model ErpSyncIssue {
  id    String     @id @default(cuid())
  runId String
  run   ErpSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// The ERP's own code for the row that did not land.
  externalCode String
  /// Whatever name came with it, to make the list readable.
  label  String?
  reason String

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([externalCode])
}

/// Which account a peşin order's money lands in.
///
/// There is no cashier standing there: the order may arrive from the customer's
/// own browser at midnight, so the account has to have been decided in advance.
/// Collections are different — a human is filling in that form, and picks the
/// account on it.
model PaymentMethodAccount {
  /// One account per method, enforced by the database rather than by a
  /// check-then-write in an admin screen.
  method PaymentMethod @id

  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// ─────────────────────────────────────────────
// SALES REP FIELD VISIT (CHECK-IN)
// ─────────────────────────────────────────────

model CheckIn {
  id         String  @id @default(cuid())
  salesRepId String
  salesRep   User    @relation(fields: [salesRepId], references: [id])
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])

  latitude   Float?
  longitude  Float?
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  note       String?

  /// Which application recorded the visit, derived server-side from the
  /// credential the request carried — never from the request body.
  ///
  /// It matters because the two are not equally good evidence: the phone app
  /// reads a real GPS fix at the customer's door, while a browser on a desk
  /// reports whatever the operating system guesses (often the office, often
  /// nothing). Without this column a visit typed in at the office and a visit
  /// made in the field are indistinguishable in the same report. Existing rows
  /// default to MOBILE because until now the app was the only writer.
  source FieldEntrySource @default(MOBILE)

  /// How long the visit lasted, written once at check-out. Null while the visit
  /// is still open.
  ///
  /// Stored rather than computed because the report engine has no expression
  /// support: a derived column would have to be written twice (once in SQL for
  /// grouped reports, once in the Prisma read path for flat ones), and the two
  /// would drift. It is also the field a manager actually groups by — "average
  /// minutes per rep" is one SUM/AVG over a column, not a subquery.
  durationMinutes Int?

  @@index([salesRepId])
  @@index([companyId])
  /// "Is this rep still inside an open visit" — read before every check-in.
  @@index([salesRepId, checkOutAt])
}

// ─────────────────────────────────────────────
// SAHA HEDEFLERİ & ZİYARET ÇAĞRISI
// ─────────────────────────────────────────────

/// Hangi büyüklük ölçülüyor.
enum TargetMetric {
  VISITS // ziyaret noktası (tamamlanmış check-in sayısı)
  REVENUE // ciro (iptal edilmemiş siparişlerin genel toplamı)
}

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Bir plasiyerin bir dönem için hedefi.
///
/// Dönem "başlangıç tarihi + periyot" olarak saklanıyor, başlangıç/bitiş çifti
/// olarak değil: aksi hâlde aynı ayın iki farklı aralıkla iki kez
/// tanımlanabilir ve hangisinin geçerli olduğu belirsiz kalırdı. Başlangıç
/// tarihi periyoda göre normalleştirilir (haftalar pazartesi, aylar ayın 1'i),
/// böylece `@@unique` gerçekten "aynı dönem" demek olur.
///
/// Gerçekleşen değer **saklanmaz**, her okunuşta hareketlerden hesaplanır.
/// Saklansaydı iptal edilen bir sipariş ya da silinen bir ziyaret hedefi
/// olduğundan iyi göstermeye devam ederdi.
model SalesTarget {
  id         String @id @default(cuid())
  salesRepId String
  salesRep   User   @relation("SalesTargetRep", fields: [salesRepId], references: [id], onDelete: Cascade)

  metric      TargetMetric
  period      TargetPeriod
  /// Dönemin ilk günü (yerel gün başı olarak normalleştirilmiş).
  periodStart DateTime
  /// Ziyaret hedefinde adet, ciro hedefinde tutar. Tek kolon: ikisini ayrı
  /// kolonlara koymak her okumada "hangisi dolu" sorusunu doğururdu.
  targetValue Decimal      @db.Decimal(14, 2)
  note        String?

  createdById String
  createdBy   User   @relation("SalesTargetAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesRepId, metric, period, periodStart])
  @@index([salesRepId, periodStart])
}

enum VisitRequestStatus {
  OPEN // bayi çağırdı, henüz gidilmedi
  PLANNED // plasiyer güne aldı
  DONE // ziyaret edildi
  CANCELLED
}

/// "Bizi arayın / uğrayın" çağrısı.
///
/// Bayi kendi portalından açar, plasiyerin o günkü ziyaret listesinde çıkar.
/// Ziyaret kaydının (`CheckIn`) yerine geçmez — biri *talep*, diğeri *kanıt*.
/// Talep karşılandığında `checkInId` ile eşleşir, böylece "çağrıdan kaç saat
/// sonra gidildi" sorusu cevaplanabilir.
model VisitRequest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Kime düşecek. Çağrı anındaki portföy sahibi yazılır; portföy sonradan
  /// değişse bile açık çağrı kaybolmasın diye ayrı kolon.
  salesRepId String?
  salesRep   User?   @relation("VisitRequestRep", fields: [salesRepId], references: [id])

  /// Bayinin istediği gün. Boşsa "en kısa sürede".
  requestedFor DateTime?
  note         String?
  status       VisitRequestStatus @default(OPEN)

  /// Plasiyerin gün içindeki elle sıralaması. Küçük olan üstte; eşitse
  /// oluşturulma sırası. Sunucuda tutuluyor çünkü sıra telefonla web arasında
  /// aynı olmalı.
  sortIndex Int @default(0)

  createdById String?
  createdBy   User?   @relation("VisitRequestAuthor", fields: [createdById], references: [id])

  /// Talebi kapatan ziyaret.
  checkInId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([companyId])
  @@index([salesRepId, status])
  @@index([status, requestedFor])
}

// ─────────────────────────────────────────────
// CART (quick order / draft)
// ─────────────────────────────────────────────

model Cart {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Owner (staff or sales rep who is building this cart)
  ownerId String

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One open cart per person per customer. A sales rep building carts for
  /// three different customers keeps three; the same person on phone and
  /// laptop shares one, which is the whole point of storing it here.
  @@unique([companyId, ownerId])
  @@index([companyId])
  @@index([ownerId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────
// USER-DEFINED REPORTS
// ─────────────────────────────────────────────

/// Which table a report reads. Each value maps to an entry in the services-side
/// dataset registry, which is the only place a field name may come from.
enum ReportDataset {
  ORDERS
  ORDER_ITEMS
  LEDGER
  COMPANIES
  CHECKINS
  CASH
  PROMOTIONS
  STOCK
}

model ReportDefinition {
  id          String        @id @default(cuid())
  name        String
  description String?
  dataset     ReportDataset

  ownerId String
  owner   User   @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Visible to every user who may run reports, not just the owner.
  isShared Boolean @default(false)

  /// Columns, filters, grouping, sorting and layout.
  /// Re-validated against the dataset registry on every write AND every run —
  /// a stored config is never trusted, so a row edited in the database cannot
  /// widen what the report reads.
  config Json

  /// ─── Scheduled delivery ───
  ///
  /// A saved report can mail itself. The schedule lives on the definition rather
  /// than in a table of its own because there is at most one per report and the
  /// two are deleted together — a schedule pointing at a deleted report is a
  /// state nobody should have to handle.
  ///
  /// null interval = not scheduled. The runner reads `scheduleNextRunAt` and,
  /// exactly like the job scheduler, claims a report by pushing that timestamp
  /// forward before running it.
  scheduleIntervalMinutes Int?
  /// Where the file goes. Free-form addresses on purpose: the recipients of a
  /// weekly sales sheet are usually people without an account (an accountant,
  /// an owner). What they receive is still bounded by the OWNER's row scope.
  scheduleRecipients      String[]  @default([])
  /// "CSV" or "XLSX". Text rather than an enum: the set is owned by the Zod
  /// schema next to the rest of the report vocabulary, and a value this column
  /// does not recognise falls back to CSV instead of failing the delivery.
  scheduleFormat          String    @default("CSV")
  scheduleNextRunAt       DateTime?
  scheduleLastRunAt       DateTime?
  /// "OK" / "ERROR" plus a one-line summary, so the operator sees the last
  /// delivery on the report list instead of digging through job runs.
  scheduleLastStatus      String?
  scheduleLastSummary     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([dataset])
  /// The delivery job's only query: which reports are due.
  @@index([scheduleNextRunAt])
}

/// A board of saved reports shown together.
///
/// The board stores nothing but an ordered list of tiles pointing at
/// `ReportDefinition` rows — no copy of a report's config, so a report that is
/// edited is edited everywhere it appears. A tile whose report was deleted, or
/// which the viewer may not open, is reported as a broken tile rather than
/// taking the board down with it.
///
/// Each tile is run under the VIEWER's row scope, exactly like opening the
/// report itself, so sharing a board can never widen what someone sees.
model ReportDashboard {
  id          String  @id @default(cuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Visible to every user who may build reports, not just the owner.
  isShared Boolean @default(false)

  /// `[{ definitionId, width, title? }]` — validated on write and on read.
  tiles Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ─────────────────────────────────────────────
// PASSWORD RESET
// ─────────────────────────────────────────────

/// A "forgot password" ticket.
///
/// Only the SHA-256 of the token is stored: the plaintext exists in the e-mail
/// and nowhere else, so a database dump does not hand out reset links. Rows are
/// single-use (`usedAt`) and short-lived, and asking for a new one invalidates
/// the outstanding ones for that account.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  /// Where the request came from, for the audit trail.
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// AUDIT TRAIL
// ─────────────────────────────────────────────

/// What happened. Kept as an enum so the log cannot fill up with typo'd action
/// names, and so the viewer can offer a closed filter list.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_CHANGED // by the account owner
  PASSWORD_RESET // by an administrator
  PASSWORD_RESET_REQUESTED // "forgot password" e-mail asked for
  PASSWORD_RESET_COMPLETED // set through a reset link
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  PROFILE_UPDATED
  SESSION_REVOKED // stale/disabled principal turned away mid-session
  ACCESS_DENIED // authenticated but not allowed here
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_PERMISSIONS_CHANGED // yetki kümesi kısıldı/genişletildi
  USER_DEACTIVATED
  USER_ACTIVATED
  USER_DELETED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DELETED
  MEDIA_UPLOADED // a file landed on the server's disk
  AUDIT_PURGED // old trail entries deleted under the retention policy
  AUDIT_EXPORTED // the trail was taken off the system as a file
  /// Bakım işi açıldı/kapatıldı ya da periyodu değişti. Kapatılmış bir temizlik
  /// işi haftalar sonra fark edildiğinde, kimin kapattığını gösteren tek kayıt.
  JOB_SCHEDULE_CHANGED
}

/// Append-only record of security-relevant events. Nothing in the application
/// updates or deletes a row here.
model AuditLog {
  id String @id @default(cuid())

  /// Null when the actor is unknown (failed login for an unregistered e-mail)
  /// or was deleted afterwards — which is why the e-mail is denormalised.
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  actorEmail String
  actorRole  Role?

  action AuditAction

  /// Which record the action touched, e.g. entity "User", entityId <cuid>.
  entity   String?
  entityId String?

  /// Human-readable one-liner shown in the viewer.
  summary String

  /// Extra detail (changed fields, denied path, …). Never store secrets here.
  meta Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
  /// Failed logins are counted per source address, so the throttle reads this
  /// table rather than keeping a second one that could disagree with it.
  @@index([ip, action, createdAt])
}

// ─────────────────────────────────────────────
// VİTRİN DUYURULARI (kampanya bandı / açılış duyurusu)
// ─────────────────────────────────────────────

enum AnnouncementPlacement {
  /// Sayfanın en üstünde, kayan şerit. Birden fazlası yan yana akar.
  TICKER
  /// Katalogun üstünde duran, çarpıyla kapatılabilen kart.
  BANNER
  /// Girişte bir kez açılan, çarpıyla kapatılan pencere.
  MODAL
}

/// Bir vitrin duyurusu. Promotion (fiyatı değiştiren kural) ile bilerek ayrı:
/// bu yalnızca *gösterim*tir, hiçbir tutarı etkilemez. Bir kampanyayı
/// duyurmak için `promotionId` bağlanabilir ama zorunlu değil — "yılbaşında
/// kapalıyız" da bir duyurudur.
model Announcement {
  id String @id @default(cuid())

  title String
  body  String?

  /// Tıklanınca gidilecek yer (kategori, ürün, dış bağlantı). Null = tıklanamaz.
  linkUrl   String?
  linkLabel String?

  placement AnnouncementPlacement @default(BANNER)

  /// Görsel vurgu tonu — arayüzdeki Badge tonlarıyla aynı sözlük.
  tone String @default("brand")

  /// Kapatılabilir mi? Kapatılırsa tarayıcıda hatırlanır (id bazlı).
  dismissible Boolean @default(true)

  enabled  Boolean @default(true)
  priority Int     @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  /// Boş = herkese. Doluysa yalnızca bu müşteri gruplarına gösterilir —
  /// "yalnızca bayilere" tipi duyuru bu yüzden var.
  customerGroupIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, placement, priority])
}

// ─────────────────────────────────────────────
// SAYFA DÜZENİ
// ─────────────────────────────────────────────
//
// Vitrinin hangi bloktan oluştuğu ve blokların sırası koda gömülüydü: duyuru
// şeridi arama kutusunun üstündeydi çünkü JSX'te oradaydı. Bunu değiştirmek
// derleme ve dağıtım istiyordu, oysa "kampanya bandını yukarı al" bir tasarım
// kararı, bir yazılım değişikliği değil.
//
// Düzen artık **veri**: sıralı bir blok listesi. Rapor tasarımcısı (Adım 9) ve
// kampanya motoruyla (Adım 12) aynı kalıp — blok tipleri sunucudaki kayıt
// defterinde tanımlı ve istemciden gelen hiçbir tip doğrudan kabul edilmiyor.
// Kayıt defterinde olmayan blok **çizilmez**; böylece eski bir kayıt yeni sürümü
// düşüremez.

/// Bir sayfanın blok dizilimi. Sayfa başına tek satır (`key` tekil) — kurulum
/// başına tek vitrin var, `tenantId` yok (bkz. ürün modeli).
model PageLayout {
  id String @id @default(cuid())

  /// Hangi sayfa. Kayıt defterindeki sayfa anahtarlarından biri ("PORTAL_HOME").
  key String @unique

  /// Sıralı blok listesi: `[{ "type": "PRODUCT_GRID", "params": {…} }]`.
  /// Şeması sunucuda doğrulanıyor; burada JSON çünkü blok tipleri kod
  /// sürümüyle birlikte büyüyor ve her yeni blok bir göç istememeli.
  blocks Json @default("[]")

  updatedById String?
  updatedBy   User?   @relation("PageLayoutUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PUSH BİLDİRİM
// ─────────────────────────────────────────────

/// Bir telefona bildirim göndermek için gereken adres.
///
/// Kullanıcı başına birden çok satır olabilir — aynı kişi hem kendi telefonunu
/// hem şirket tabletini kullanıyor olabilir — ama bir jeton (`token`) yalnızca
/// bir kullanıcıya ait olabilir. Bu yüzden `token` tekil: aynı cihazdan başka
/// biri giriş yaptığında satır yeni kullanıcıya taşınır. Aksi halde eski
/// kullanıcının sipariş bildirimleri, o cihazı devralan kişiye düşerdi.
model PushDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PushDeviceOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// Expo'nun ürettiği adres: `ExponentPushToken[...]`. Sır değil ama kişiye
  /// bağlı bir tanıtıcı, bu yüzden dışarıya hiçbir uçtan geri dönülmüyor.
  token    String  @unique
  platform String
  /// "Said'in telefonu" gibi — kullanıcı hangi cihazı çıkardığını görebilsin.
  deviceName String?

  /// Expo "bu cihaz artık kayıtlı değil" dediğinde doluyor (uygulama silinmiş
  /// ya da izin kapatılmış). Satır silinmiyor: aynı cihaz geri geldiğinde
  /// hangi kullanıcıya ait olduğu bilinsin ve kaç cihazın düştüğü görülsün.
  disabledAt DateTime?

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, disabledAt])
}
