{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.*"
  ],
  "globalEnv": [
    "AUTH_SECRET",
    "DATABASE_URL",
    "NODE_ENV",
    "TEST_SCHEMA",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^db:generate"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^db:generate"
      ],
      "outputs": []
    },
    "web#test": {
      "dependsOn": [
        "^db:generate",
        "@repo/services#test"
      ],
      "outputs": []
    }
  }
}
