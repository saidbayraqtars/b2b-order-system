# Copy to .env at repo root and per-app as needed.

# ── Database (used by packages/database + web server) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/b2b?schema=public"

# ── Auth.js v5 (web) ──
# Generate with: npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ── E-mail ──
# Where links in e-mails point (password reset, order notifications).
APP_URL="http://localhost:3000"
MAIL_FROM="B2B <no-reply@b2b.local>"

# Leave SMTP_HOST empty to use the console transport: every message is printed
# to the server log instead of being sent. That is the intended setup for local
# development — the whole "şifremi unuttum" flow works without a mail account,
# and the reset link is in the terminal.
SMTP_HOST=""
SMTP_PORT="587"
# Defaults to true only on port 465 (implicit TLS); 587 upgrades via STARTTLS.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# ── Uploads ──
# Where uploaded product images are written. Served back through /api/media,
# not from public/, so the directory can live anywhere — including a volume
# mounted into a container.
UPLOAD_DIR=""
