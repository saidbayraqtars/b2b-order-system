# Copy to .env at repo root and per-app as needed.

# ── Database (used by packages/database + web server) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/b2b?schema=public"

# ── Auth.js v5 (web) ──
# Generate with: npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ── E-mail ──
# Where links in e-mails point (password reset, order notifications).
APP_URL="http://localhost:3000"
MAIL_FROM="B2B <no-reply@b2b.local>"

# Leave SMTP_HOST empty to use the console transport: every message is printed
# to the server log instead of being sent. That is the intended setup for local
# development — the whole "şifremi unuttum" flow works without a mail account,
# and the reset link is in the terminal.
SMTP_HOST=""
SMTP_PORT="587"
# Defaults to true only on port 465 (implicit TLS); 587 upgrades via STARTTLS.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# ── Uploads ──
# Where uploaded product images are written. Served back through /api/media,
# not from public/, so the directory can live anywhere — including a volume
# mounted into a container.
UPLOAD_DIR=""

# ── Nesne deposu (isteğe bağlı: S3 / MinIO / R2) ──
# S3_BUCKET doldurulduğu anda görseller diske değil bu kovaya yazılır ve
# UPLOAD_DIR aranmaz. Tek sunucuda çalışan kurulumların buna ihtiyacı yok;
# uygulamayı iki kopya çalıştıran ya da diski kalıcı olmayan bir yerde
# (Fly, Render, Cloud Run) barındıran kurulumlar için şart — orada disk,
# bir kopyanın yazdığını diğerinin göremediği bir depodur.
# Kova verilip anahtarlar verilmezse uygulama açılışta durur: eksik
# yapılandırmayla diske düşmek, kapsayıcı yenilenene kadar çalışıp sonra
# bütün görselleri kaybetmek demek.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS'te boş bırakın (bölgeden türetilir). MinIO/R2 için kendi adresi:
#   http://localhost:9000  ·  https://<hesap>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="us-east-1"
# Kendi uç noktası verilince yol biçimi (/kova/anahtar) varsayılan; AWS'te
# alan adı biçimi kalır. Zorlamak için "true"/"false".
S3_FORCE_PATH_STYLE=""
# Kovayı başka bir işle paylaşıyorsanız anahtarların önüne geçecek klasör.
S3_PREFIX=""

# ── İki adımlı doğrulama (TOTP) ──
# Kullanıcıların authenticator anahtarlarını şifreleyen anahtar (AES-256-GCM).
# Tanımsızsa iki adımlı doğrulama kurulamaz; uygulama düz metne düşmez, hata
# verir. Anahtar ortamda, şifrelediği veri veritabanında — ikisi ayrı yerde
# olduğu için tek başına bir yedek sırları açmaz.
# Üret:  openssl rand -base64 32
# Değiştirmek kayıtlı anahtarları okunamaz kılar (herkes yeniden kurar).
TOTP_ENCRYPTION_KEY=""
