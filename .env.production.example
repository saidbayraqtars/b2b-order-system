# Üretim yapılandırması. Sunucuda `.env.production` adıyla kopyalayın ve
# doldurun. Bu dosya depoya girer, doldurulmuş hâli **girmez**.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Compose hem `--env-file` ile buradan okur (yerine koymalar için) hem de
# servislere `env_file` ile aktarır.

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Sunucu adı `db`: Compose ağındaki servis adı, localhost değil.
POSTGRES_USER="b2b"
POSTGRES_PASSWORD=""
POSTGRES_DB="b2b"
DATABASE_URL="postgresql://b2b:BURAYA_AYNI_SIFRE@db:5432/b2b?schema=public"

# ── Kimlik ────────────────────────────────────────────────────────────────────
# Üretin: openssl rand -base64 33
# Değiştirildiği anda tüm oturumlar ve mobil jetonlar geçersiz olur (istenen
# davranış: sızıntı şüphesinde herkesi dışarı atmanın yolu budur).
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ── Adres ─────────────────────────────────────────────────────────────────────
# E-postadaki bağlantılar buradan üretiliyor. Müşterinin tarayıcısında açılan
# adres ne ise o. https olmalı.
APP_URL="https://siparis.musteri.com.tr"
# Web kapsayıcısının host'ta açacağı port. Öndeki ters vekil buraya bağlanır.
WEB_PORT="3000"

# ── Kiracı klasörü ────────────────────────────────────────────────────────────
# Bu kurulumun hangi firmaya ait olduğu. Host üzerindeki yol; kapsayıcıya
# /data/tenant olarak salt okunur bağlanır. Fatura/irsaliye başlığındaki satıcı
# buradan gelir — yanlışsa belge başkasının adına basılır.
TENANT_SOURCE="./tenants/musteri"

# ── Sürüm etiketi ─────────────────────────────────────────────────────────────
# İmaj etiketi ve /api/health'in döndürdüğü değer. scripts/update.sh bunu
# kendisi ayarlar (`git describe`); elle çalıştırırken etiket adı yazın.
APP_VERSION="local"

# ── Merkezden güncelleme ──────────────────────────────────────────────────────
# Ajan (scripts/agent.sh) satıcının yayımladığı sürüm akışına bakar. Akış statik
# bir dosyadır ve **yalnızca bir git etiketinin adını** söyler; kod her zaman bu
# kurulumun kendi origin'inden gelir. Akış adresi ele geçse bile depoya
# yazamayan biri kod çalıştıramaz.
#
# Boş bırakılırsa ajan çalışmaz; kurulum elle `scripts/update.sh` ile güncellenir.
UPDATE_FEED_URL=""
# Hangi kanal okunacak: <UPDATE_FEED_URL>/<kanal>.json
UPDATE_CHANNEL="stable"
# off    → ajan hiç bakmaz (zamanlayıcıyı kapatmakla aynı)
# notify → bakar, ekranda gösterir, DOKUNMAZ  ← varsayılan
# auto   → bakım penceresinde kendisi günceller
#
# Varsayılan bilerek 'notify': müşterinin ERP'ye bağlı sipariş sistemini haberi
# olmadan yeniden başlatan bir yazılım, kazandığından çok güven kaybettirir.
UPDATE_POLICY="notify"
# Otomatik güncellemenin izinli olduğu aralık. Sunucunun yerel saati.
UPDATE_WINDOW="02:00-05:00"
# Etiketin GPG imzasını doğrula (1) — depoya yazma yetkisi ele geçse bile
# imzasız etiket yayına alınmaz. Etiketlerinizi imzalıyorsanız açın.
UPDATE_REQUIRE_SIGNED_TAG="0"
# Ajanın durum yazdığı dizin; web kapsayıcısına salt okunur bağlanır.
UPDATE_STATE_DIR="./var"
UPDATE_STATE_FILE="./var/update-state.json"

# ── E-posta ───────────────────────────────────────────────────────────────────
# Boş bırakılırsa e-posta GÖNDERİLMEZ, sunucu günlüğüne yazılır. Üretimde bu
# şifre sıfırlamanın çalışmaması demek — açılışta uyarı olarak günlüğe düşer.
MAIL_FROM="Firma Adı <siparis@musteri.com.tr>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# ── Raporlama ─────────────────────────────────────────────────────────────────
# Gün/hafta/ay kırılımları bu saat diliminde hesaplanır.
REPORT_TIMEZONE="Europe/Istanbul"

# ── Sanal POS ─────────────────────────────────────────────────────────────────
# Sağlayıcı anahtarları burada durur, kiracı klasöründe DEĞİL: o klasör destek
# akışında elden ele gidiyor. Ad kalıbı: PAYMENT_<SAĞLAYICI>_<ANAHTAR>
# PAYMENT_IYZICO_API_KEY=""
# PAYMENT_IYZICO_SECRET=""
