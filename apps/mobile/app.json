{
  "expo": {
    "name": "B2B Mobile",
    "slug": "b2b-mobile",
    "scheme": "b2bmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "url": "https://u.expo.dev/2072d26d-d5de-4e9d-9b6a-df0368d4cc1d"
    },
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.b2b.mobile"
    },
    "android": {
      "package": "com.b2b.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withGradleWrapper",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ziyaret (check-in) kaydınıza müşteri konumunu eklemek için konum izni gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Teslim edilen malın imzalı belgesini fotoğraflamak için kamera izni gerekiyor.",
          "photosPermission": "İmzalı teslim belgesini galeriden seçebilmek için izin gerekiyor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2072d26d-d5de-4e9d-9b6a-df0368d4cc1d"
      }
    },
    "owner": "saidbayraktar"
  }
}
