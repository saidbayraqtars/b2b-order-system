DATABASE_URL="postgresql://postgres:postgres@localhost:5433/b2b?schema=public"
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Where links in outgoing e-mails point.
APP_URL="http://localhost:3000"
MAIL_FROM="B2B <no-reply@b2b.local>"

# Empty SMTP_HOST → console transport: mail is printed to the server log rather
# than sent. That is the intended local setup; the reset link shows up in the
# terminal running `pnpm --filter web dev`.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# Uploaded product images. Defaults to ./uploads next to the running app.
UPLOAD_DIR=""

# ── Kiracı klasörü ──
# Bu kurulumun hangi firmaya ait olduğu: satıcı unvanı, VKN, adres, logo.
# Varsayılanı YOK — tanımsızsa fatura/irsaliye ekranı açık bir hata verir.
# Fatura basan bir sistem, kimin adına bastığını bilmiyorsa durmalıdır.
# Yol göreli verilirse çalışan sürecin dizinine göre çözülür (apps/web).
TENANT_DIR="../../tenants/demo"
