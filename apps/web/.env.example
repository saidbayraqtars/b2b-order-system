DATABASE_URL="postgresql://postgres:postgres@localhost:5433/b2b?schema=public"
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Where links in outgoing e-mails point.
APP_URL="http://localhost:3000"
MAIL_FROM="B2B <no-reply@b2b.local>"

# Empty SMTP_HOST → console transport: mail is printed to the server log rather
# than sent. That is the intended local setup; the reset link shows up in the
# terminal running `pnpm --filter web dev`.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# Uploaded product images. Defaults to ./uploads next to the running app.
UPLOAD_DIR=""

# ── Nesne deposu (isteğe bağlı: S3 / MinIO / R2) ──
# S3_BUCKET doldurulduğu anda görseller diske değil bu kovaya yazılır ve
# UPLOAD_DIR aranmaz. Tek sunucuda çalışan kurulumların buna ihtiyacı yok;
# uygulamayı iki kopya çalıştıran ya da diski kalıcı olmayan bir yerde
# (Fly, Render, Cloud Run) barındıran kurulumlar için şart — orada disk,
# bir kopyanın yazdığını diğerinin göremediği bir depodur.
# Kova verilip anahtarlar verilmezse uygulama açılışta durur: eksik
# yapılandırmayla diske düşmek, kapsayıcı yenilenene kadar çalışıp sonra
# bütün görselleri kaybetmek demek.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS'te boş bırakın (bölgeden türetilir). MinIO/R2 için kendi adresi:
#   http://localhost:9000  ·  https://<hesap>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="us-east-1"
# Kendi uç noktası verilince yol biçimi (/kova/anahtar) varsayılan; AWS'te
# alan adı biçimi kalır. Zorlamak için "true"/"false".
S3_FORCE_PATH_STYLE=""
# Kovayı başka bir işle paylaşıyorsanız anahtarların önüne geçecek klasör.
S3_PREFIX=""

# ── Kiracı klasörü ──
# Bu kurulumun hangi firmaya ait olduğu: satıcı unvanı, VKN, adres, logo.
# Varsayılanı YOK — tanımsızsa fatura/irsaliye ekranı açık bir hata verir.
# Fatura basan bir sistem, kimin adına bastığını bilmiyorsa durmalıdır.
# Yol göreli verilirse çalışan sürecin dizinine göre çözülür (apps/web).
TENANT_DIR="../../tenants/demo"

# Gösterim girişi (yalnızca geliştirme): /login sayfasında tek tıkla giriş
# düğmeleri çıkar. Temiz kurulum denerken kapalı bırakın.
#DEMO_LOGIN=1

# ── İki adımlı doğrulama (TOTP) ──
# Kullanıcıların authenticator anahtarları bu anahtarla şifrelenir (AES-256-GCM).
# Varsayılanı YOK ve olmamalı: tanımsızsa 2FA kurulmaz, sessizce düz metne
# düşmez. Veritabanında değil ortamda durduğu için tek başına bir veritabanı
# yedeği ikinci adımı açmaya yetmez.
# Üret:  openssl rand -base64 32
# DİKKAT: Bu anahtarı değiştirmek kayıtlı bütün TOTP anahtarlarını okunamaz
# hâle getirir — herkes 2FA'sını yeniden kurmak zorunda kalır.
TOTP_ENCRYPTION_KEY=""
